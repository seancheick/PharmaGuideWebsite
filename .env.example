# =============================================================================
# PharmaGuide Website — environment variables template
# Copy to `.env` (gitignored) for local dev.
# Add the same keys to Vercel project settings (Production + Preview).
# =============================================================================

# ─── Site URL (canonical for SEO) ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://pharmaguide.io

# ─── Analytics ───────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=

# ─── Search-engine ownership verification ────────────────────────────
# Paste the verification token (NOT the full meta tag) from each platform.
# Next.js emits the appropriate <meta> tag automatically when set.

# Google Search Console — https://search.google.com/search-console
# Pick "HTML tag" verification method, copy the `content="..."` value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools — https://www.bing.com/webmasters
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Yandex Webmaster (optional — useful only if Russian SEO matters)
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# ─── Resend (email + waitlist) ───────────────────────────────────────
# Required — server boot throws if any of these three are missing.
# Get from https://resend.com/api-keys
RESEND_API_KEY=

# Optional stable signing key for unsubscribe links. Generate once with
# openssl rand -hex 32 and retain it when rotating the Resend API key.
# If unset, links use RESEND_API_KEY and stop working when that key changes.
EMAIL_UNSUBSCRIBE_SECRET=

# Set after reviewing the prepared sequence. Keep false until Sean approves sends.
RESEND_WAITING_SEQUENCE_ENABLED=false
RESEND_WAITING_SEQUENCE_STARTED_AT=
RESEND_BETA_WAITING_SEGMENT_ID=
RESEND_BETA_TOPIC_ID=
RESEND_NEWSLETTER_TOPIC_ID=
# Signing secret from the Resend webhook. Server verifies every request.
RESEND_WEBHOOK_SECRET=
# Owner test inboxes for scripts/email-ops.mjs, comma-separated. Local only.
EMAIL_TEST_ADDRESSES=

# Audience IDs from https://resend.com/audiences
RESEND_AUDIENCE_BETA_ID=
RESEND_AUDIENCE_NEWSLETTER_ID=

# Sender + reply-to (must be on a verified domain). Optional —
# defaults to "Sean at PharmaGuide <hello@pharmaguide.io>" + "info@pharmaguide.io".
RESEND_FROM_EMAIL="Sean at PharmaGuide <hello@pharmaguide.io>"
RESEND_REPLY_TO_EMAIL=info@pharmaguide.io

# ─── Upstash (rate limiting) ─────────────────────────────────────────
# Required in production. Optional in dev (rate limiter falls back
# to allow-with-warning). Provision a free Redis database at
# https://console.upstash.com — pick "Global" or your nearest region.
# Copy "REST URL" and "REST Token" from the database dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Supabase (product share links) ──────────────────────────────────
# Backs POST /api/share and the /s/[code] landing page.
#
# Optional everywhere, including production: when unset, /api/share
# returns 503 and the app silently falls back to its text-only share.
# Sharing is additive, so a missing key disables a feature rather than
# breaking the site.
#
# Project: PharmaGuide_Pipeline (same project as the catalog pipeline).
# Settings → API in the Supabase dashboard.
SUPABASE_URL=https://omayamxacvacrnvdvzhr.supabase.co

# Service role key. BYPASSES row-level security — server-side only,
# never prefix with NEXT_PUBLIC_, never ship to the client. Used only by
# server-side share resolution, snapshot writes, and code-scoped reads.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI connector (/oauth/authorize, /account/connections) ──────────────
# Browser sign-in and OAuth consent use the publishable key and the user's
# own session. Unset = the pages say connecting is unavailable.
NEXT_PUBLIC_SUPABASE_URL=https://omayamxacvacrnvdvzhr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. The pre-registered assistants the consent page may approve
# (S3), by Supabase OAuth client id. kind: claude | chatgpt | claude_code.
# Unknown or malformed entries approve nothing.
# AI_CONNECTOR_TRUSTED_CLIENTS=[{"client_id":"…","name":"Claude","kind":"claude"}]
AI_CONNECTOR_TRUSTED_CLIENTS=

# ─── Chat assistant → chatbot API ────────────────────────────────────
# Optional shared secret. Must equal PG_PROXY_SECRET in the pharmaguide-chatbot-api
# Vercel project. Generate with: openssl rand -hex 32
PG_PROXY_SECRET=
# Optional key for the one-way hash of visitor addresses used by the chat rate
# limiter. Falls back to the Upstash token when empty.
RATE_LIMIT_SALT=
